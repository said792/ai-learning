# =========================================================
#  AI Learning — نموذج متغيرات البيئة (.env.example)
#  انسخ الملف ده لـ .env.local واملأ قيمك الحقيقية
#  (.env.local لا يُرفع أبدًا إلى Git — ملف أمان)
# =========================================================

# ---------- Supabase (إلزامي) ----------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Gemini: برج المفاتيح المجاني ----------
# مفاتيح من مشاريع Google Cloud بدون فاتورة — للضيوف والمستخدمين المجانيين
# تذكير: حصة جوجل تُحسب على مستوى المشروع (Project) وليس المفتاح،
#        فوزّع المفاتيح على مشاريع مختلفة لمضاعفة الحصص.
GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# ... حتى 50

# ---------- Gemini: برج المفاتيح المدفوعة (اختياري — v2.3.2) ----------
# مفاتيح من مشاريع Google Cloud عليها حساب فاتورة (Billing مفعّل → Tier 1)
# تُستخدم تلقائيًا لطلبات المستخدمين على الباقات المدفوعة (دروس صوت/فيديو + شات)
# بدونها التطبيق يعمل عادي على البرج المجاني — صفر كسر.
GEMINI_PAID_API_KEY_1=
# GEMINI_PAID_API_KEY_2=
# ... حتى 50

# ---------- الموديلات (اختياري) ----------
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-001

# ---------- الحدود اليومية للضيوف والمستخدمين (اختياري) ----------
GUEST_DAILY_LIMIT=3
CHAT_GUEST_DAILY_LIMIT=10
CHAT_USER_DAILY_LIMIT=100

# ---------- معالجة صور المستندات (اختياري) ----------
DOC_IMAGES_MAX_PAGES=20
DOC_IMAGES_MAX_ANALYZED=12
